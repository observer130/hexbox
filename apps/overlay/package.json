{
  "name": "@hexbox/overlay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "游戏内悬浮窗（不注入 / 不读内存 / 不打开游戏进程句柄）",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node build.mjs && node run-electron.mjs .",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "debug:capture": "node build.mjs && node run-electron.mjs dist/debug-capture.cjs",
    "debug:augment": "node build.mjs && node run-electron.mjs dist/debug-augment.cjs",
    "debug:overlay-test": "node build.mjs && node run-electron.mjs dist/debug-overlay-test.cjs",
    "package:dir": "node build.mjs && electron-builder --dir",
    "package:win": "node build.mjs && electron-builder --win"
  },
  "author": "hexbox",
  "dependencies": {
    "@hexbox/core": "workspace:*",
    "@hexbox/data-store": "workspace:*",
    "@hexbox/lcu": "workspace:*",
    "@hexbox/vision": "workspace:*"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.2"
  }
}
