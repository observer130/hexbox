{
  "name": "@hexbox/lcu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LCU 本地客户端探测与 REST 访问（不打开游戏进程句柄）",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@hexbox/core": "workspace:*",
    "@hexbox/data-store": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test src/**/*.test.ts",
    "probe": "node --experimental-strip-types src/cli.ts",
    "probe:live": "node --experimental-strip-types src/probe-live.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
